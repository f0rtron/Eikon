# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mysql name 
DB_USER=root
DB_PASSWORD=acha sa password choose kr lena mysql ka

# ─── Flask ────────────────────────────────────────────────────────────────────
SECRET_KEY=DEBUG=False
HOST=0.0.0.0
PORT=5000

# ─── Face Recognition ─────────────────────────────────────────────────────────
# buffalo_sc = lightweight, recommended for Raspberry Pi
# buffalo_l  = full accuracy, for laptop/desktop only
MODEL_NAME=buffalo_sc
RECOGNITION_THRESHOLD=0.55
ANTI_SPOOF_THRESHOLD=0.7
IMAGES_PER_STUDENT=30
DUPLICATE_WINDOW_SECS=3600

# ─── Email Alerts ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_gmail_app_password
ALERT_ABSENT_DAYS=3

# ─── Raspberry Pi GPIO (only needed when running on Pi) ──────────────────────
GPIO_LED_GREEN=17
GPIO_LED_RED=27
GPIO_BUZZER=22

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO


CAMERA_SOURCE=0
STREAM_QUALITY=80
LATE_GRACE_MINUTES=10
REREG_CONFIDENCE_THRESHOLD=0.65
REREG_CHECK_LAST_N=5


GROQ_API_KEY=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
